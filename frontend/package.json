{
  "name": "smart-rowing-frontend",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev -H 0.0.0.0 -p 5173",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "start": "NEXT_DIST_DIR=.next-build next start -p 5173",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "og:thumbs": "node scripts/generate-og-thumbs.mjs"
  },
  "dependencies": {
    "next": "15.5.22",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.10.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.22",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.2",
    "vitest": "^2.1.9",
    "wrangler": "^4.118.0"
  }
}
