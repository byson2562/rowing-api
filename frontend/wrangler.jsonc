{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 完全静的サイト。Worker スクリプトは持たず(main なし)、next build の out/ を
  // Workers Static Assets としてそのまま配信する。Worker 名とカスタムドメインは
  // OpenNext 時代と同じなので、デプロイしても DNS やルートの変更はいらない。
  "name": "regattanavi",
  "compatibility_date": "2025-09-23",
  "routes": [
    { "pattern": "regattanavi.jp", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    // /results/2026 → out/results/2026.html を返し、/results/2026/ は /results/2026 へ 307。
    // Next の trailingSlash: false と対応する
    "html_handling": "auto-trailing-slash",
    // 存在しないパスは Next が書き出す out/404.html を 404 で返す
    "not_found_handling": "404-page"
  }
}
