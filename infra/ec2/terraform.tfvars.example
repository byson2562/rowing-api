aws_region     = "ap-northeast-1"
name_prefix    = "rowing-api"
vpc_id         = "vpc-xxxxxxxx"
subnet_id      = "subnet-xxxxxxxx"
instance_type  = "t4g.small"
root_volume_size = 40
key_name       = "your-keypair-name"
ssh_cidr       = "x.x.x.x/32"

repo_url       = "https://github.com/byson2562/rowing-api.git"
repo_branch    = "main"
deploy_user    = "ec2-user"
app_dir        = "/opt/rowing-api"
enable_user_data = true

ecr_backend_repository_name = "rowing-api/backend"
ecr_frontend_repository_name = "rowing-api/frontend"

github_repository           = "byson2562/rowing-api"
github_branch               = "main"
github_actions_role_name    = "rowing-api-github-actions-ecr-push"

ec2_ecr_pull_role_name             = "rowing-api-ec2-ecr-pull"
ec2_ecr_pull_instance_profile_name = "rowing-api-ec2-ecr-pull-profile"

tags = {
  Project = "rowing-api"
  Env     = "prod"
}
