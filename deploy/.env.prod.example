# Domain
DOMAIN=example.com

# ECR image settings
ECR_REGISTRY=123456789012.dkr.ecr.ap-northeast-1.amazonaws.com
ECR_REPOSITORY_FRONTEND=rowing-api/frontend
IMAGE_TAG=latest

# Frontend
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: set a project name to avoid conflicts with local compose
COMPOSE_PROJECT_NAME=rowing_api_prod
