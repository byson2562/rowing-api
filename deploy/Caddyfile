{$DOMAIN} {
  encode zstd gzip

  log {
    output file /var/log/caddy/access.log {
      roll_size 50MiB
      roll_keep 10
      roll_keep_for 168h
    }
    format json
    level INFO
  }

  header {
    X-Frame-Options "SAMEORIGIN"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  reverse_proxy frontend:5173
}
